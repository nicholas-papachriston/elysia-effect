{
  "name": "elysia-effect",
  "version": "0.1.0",
  "description": "Elysia plugin for Effect programs, schemas, errors, streams, and cron",
  "keywords": [
    "bun",
    "effect",
    "elysia",
    "plugin",
    "schema",
    "sse"
  ],
  "homepage": "https://github.com/nicholas-papachriston/elysia-effect#readme",
  "bugs": {
    "url": "https://github.com/nicholas-papachriston/elysia-effect/issues"
  },
  "license": "MIT",
  "author": "https://github.com/nicholas-papachriston",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicholas-papachriston/elysia-effect.git"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./context": {
      "types": "./src/context.ts",
      "default": "./src/context.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./handler": {
      "types": "./src/handler.ts",
      "default": "./src/handler.ts"
    },
    "./openapi": {
      "types": "./src/openapi.ts",
      "default": "./src/openapi.ts"
    },
    "./plugin": {
      "types": "./src/plugin.ts",
      "default": "./src/plugin.ts"
    },
    "./queue": {
      "types": "./src/queue.ts",
      "default": "./src/queue.ts"
    },
    "./routes": {
      "types": "./src/routes.ts",
      "default": "./src/routes.ts"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "default": "./src/runtime.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./stream": {
      "types": "./src/stream.ts",
      "default": "./src/stream.ts"
    },
    "./telemetry": {
      "types": "./src/telemetry.ts",
      "default": "./src/telemetry.ts"
    },
    "./scheduler": {
      "types": "./src/scheduler.ts",
      "default": "./src/scheduler.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck",
    "fix": "oxfmt && oxlint --fix .",
    "lint": "oxfmt && oxlint --fix . && oxfmt --check && oxlint .",
    "prepublishOnly": "bun run check && bun test",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@elysiajs/cron": "^1.4.0",
    "@types/bun": "^1.3.14",
    "effect": "^3.18.0",
    "elysia": "^1.4.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@elysiajs/cron": "^1.4.0",
    "effect": "^3.18.0",
    "elysia": "^1.4.0"
  },
  "peerDependenciesMeta": {
    "@elysiajs/cron": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
